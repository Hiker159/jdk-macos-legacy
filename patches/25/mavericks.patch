+/* Copyright (c) 2026, jdk-macos-legacy contributors.
+ * SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0
+ */
+#ifndef LEGACY_MACOS_FS_H
+#define LEGACY_MACOS_FS_H
+#include <errno.h>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <sys/time.h>
+
+/* These fallbacks serve the JNI timestamp methods, which supply two explicit
+ * timestamps, never NULL, UTIME_NOW or UTIME_OMIT. Mavericks has microsecond
+ * timestamp setters. Keep invalid nanosecond values invalid (Java retries
+ * negative timestamps with the epoch), rather than accidentally rounding them.
+ */
+static int legacy_macos_timevals(const struct timespec times[2], struct timeval out[2]) {
+    for (int i = 0; i < 2; i++) {
+        if (times[i].tv_nsec < 0 || times[i].tv_nsec >= 1000000000L) {
+            errno = EINVAL;
+            return -1;
+        }
+        out[i].tv_sec = times[i].tv_sec;
+        out[i].tv_usec = times[i].tv_nsec / 1000;
+    }
+    return 0;
+}
+
+static int legacy_macos_futimens(int fd, const struct timespec times[2]) {
+    struct timeval tv[2];
+    if (legacy_macos_timevals(times, tv) != 0) return -1;
+    return futimes(fd, tv);
+}
+
+static int legacy_macos_utimensat(int fd, const char* path,
+                                const struct timespec times[2], int flags) {
+    struct timeval tv[2];
+    if (flags & ~AT_SYMLINK_NOFOLLOW) { errno = EINVAL; return -1; }
+    /* Never emulate a directory-relative operation with chdir or path joining:
+     * that would weaken SecureDirectoryStream's race guarantees. On Mavericks
+     * openat is unavailable, so Java does not advertise secure directory streams.
+     */
+    if (fd != AT_FDCWD && path[0] != '/') { errno = ENOTSUP; return -1; }
+    if (legacy_macos_timevals(times, tv) != 0) return -1;
+    return flags & AT_SYMLINK_NOFOLLOW ? lutimes(path, tv) : utimes(path, tv);
+}
+
+static int legacy_macos_fchmodat(int fd, const char* path, mode_t mode, int flags) {
+    if (flags & ~AT_SYMLINK_NOFOLLOW) { errno = EINVAL; return -1; }
+    if (fd != AT_FDCWD && path[0] != '/') { errno = ENOTSUP; return -1; }
+    return flags & AT_SYMLINK_NOFOLLOW ? lchmod(path, mode) : chmod(path, mode);
+}
+#endif
