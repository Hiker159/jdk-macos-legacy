+/*
+ * Copyright (c) 2026, jdk-macos-legacy contributors.
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+#ifndef OS_BSD_LEGACY_MACOS_CLOCK_HPP
+#define OS_BSD_LEGACY_MACOS_CLOCK_HPP
+
+#include <errno.h>
+#include <mach/mach_time.h>
+#include <sys/time.h>
+#include <time.h>
+
+// Like the bundled JDK 11 port, use gettimeofday for wall time and
+// mach_absolute_time for monotonic time. clock_gettime needs macOS 10.12.
+static inline int legacy_macos_clock_gettime(clockid_t clock, timespec* ts) {
+  if (clock == CLOCK_REALTIME) {
+    timeval tv;
+    int result = gettimeofday(&tv, nullptr);
+    if (result == 0) {
+      ts->tv_sec = tv.tv_sec;
+      ts->tv_nsec = tv.tv_usec * 1000;
+    }
+    return result;
+  }
+  if (clock == CLOCK_MONOTONIC) {
+    mach_timebase_info_data_t info;
+    if (mach_timebase_info(&info) != KERN_SUCCESS || info.denom == 0) {
+      errno = EINVAL;
+      return -1;
+    }
+    // Wide arithmetic avoids overflow after long uptime.
+    __uint128_t nanos = (__uint128_t)mach_absolute_time() * info.numer / info.denom;
+    ts->tv_sec = (time_t)(nanos / 1000000000);
+    ts->tv_nsec = (long)(nanos % 1000000000);
+    return 0;
+  }
+  errno = EINVAL;
+  return -1;
+}
+#endif
